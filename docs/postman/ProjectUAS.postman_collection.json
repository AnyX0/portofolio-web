    {
      "name": "6. Direct Upload to Cloudinary (Signed)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Auto-generate timestamp and signature untuk signed upload",
              "const crypto = require('crypto');",
              "const timestamp = Math.floor(Date.now() / 1000);",
              "const apiSecret = pm.environment.get('cloudinaryApiSecret');",
              "const folder = 'portfolio/projects/test-direct';",
              "",
              "// Build string to sign",
              "const stringToSign = `folder=${folder}&timestamp=${timestamp}${apiSecret}`;",
              "const signature = crypto.createHash('sha1').update(stringToSign).digest('hex');",
              "",
              "pm.environment.set('timestamp', timestamp);",
              "pm.environment.set('signature', signature);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "https://api.cloudinary.com/v1_1/{{cloudinaryCloudName}}/image/upload",
          "protocol": "https",
          "host": ["api","cloudinary","com"],
          "path": ["v1_1","{{cloudinaryCloudName}}","image","upload"]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "disabled": false },
            { "key": "api_key", "value": "{{cloudinaryApiKey}}", "type": "text" },
            { "key": "timestamp", "value": "{{timestamp}}", "type": "text" },
            { "key": "signature", "value": "{{signature}}", "type": "text" },
            { "key": "folder", "value": "portfolio/projects/test-direct", "type": "text" }
          ]
        }
      },
      "response": []
