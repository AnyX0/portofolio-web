{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "rewrites": [
    { "source": "/storage/(.*)", "destination": "/public/storage/$1" },
    { "source": "/build/(.*)", "destination": "/public/build/$1" },
    { "source": "/css/(.*)", "destination": "/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/public/js/$1" },
    { "source": "/images/(.*)", "destination": "/public/images/$1" },
    { "source": "/robots.txt", "destination": "/public/robots.txt" },
    { "source": "/favicon.ico", "destination": "/public/favicon.ico" },
    { "source": "/cursor.png", "destination": "/public/cursor.png" },
    { "source": "/hand-pointer.png", "destination": "/public/hand-pointer.png" },
    { "source": "/api/(.*)", "destination": "/api/index.php" },
    { "source": "/project/(.*)", "destination": "/api/index.php" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ],
  "buildCommand": "npm run build",
  "env": {
    "APP_URL": "https://anyx-project.my.id",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp",
    "CACHE_DRIVER": "array",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "QUEUE_CONNECTION": "sync"
  }
}